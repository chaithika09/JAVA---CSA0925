import java.util.*;

class Student
{
    String name;
    int age;
    int marks;

    Student(String name,int age,int marks)
    {
        this.name=name;
        this.age=age;
        this.marks=marks;
    }

    public static void main(String args[])
    {
        ArrayList<Student> AL=new ArrayList<Student>();

        AL.add(new Student("Arun",18,85));
        AL.add(new Student("Priya",19,92));
        AL.add(new Student("Rahul",18,78));

        Iterator IL=AL.iterator();

        int highest=0;

        while(IL.hasNext())
        {
            Student s=(Student)IL.next();

            System.out.println("Name : "+s.name);
            System.out.println("Age : "+s.age);
            System.out.println("Marks : "+s.marks);

            if(s.marks>highest)
                highest=s.marks;
        }

        System.out.println("Highest Marks : "+highest);
    }
}
